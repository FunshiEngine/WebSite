###############################################################################
# Normalizacion de finales de linea.
#
# `text=auto` deja que Git normalice a LF en el repositorio y a CRLF en la
# copia de trabajo de Windows. Los archivos de texto generados por Astro
# (`.astro`, `.md`, `.mdx`) se fuerzan a LF para que los diffs no mezclen
# cambios de contenido con cambios de fin de linea.
###############################################################################
* text=auto

*.astro text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

###############################################################################
# Archivos binarios: nunca se deben normalizar ni diffear.
###############################################################################
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

###############################################################################
# Imagenes generadas por el script de imagenes: se versionan, pero Git no debe
# intentar mostrarlas como texto en un diff.
###############################################################################
public/og-image.png        binary
public/apple-touch-icon.png binary
