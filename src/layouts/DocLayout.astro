---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import DocTreeNode from '../components/DocTreeNode.astro';
import { construirArbolDocs } from '../lib/docs';

/**
 * Maquetacion de la documentacion: columna de navegacion a la izquierda,
 * contenido al centro y sumario de encabezados a la derecha.
 */
interface Props {
  titulo: string;
  descripcion: string;
  eyebrow?: string;
  /** Secccion a la que pertenece la pagina (para la navegacion). */
  seccion?: string;
  /** Identificador de la pagina activa en el arbol. */
  activo?: string;
  /** Encabezados del documento, para el sumario. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { titulo, descripcion, eyebrow = 'Documentacion', seccion, activo, headings = [] } = Astro.props;

const arbol = await construirArbolDocs();

const resumen = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout titulo={titulo} descripcion={descripcion}>
  <PageHeader eyebrow={eyebrow} titulo={titulo} lede={descripcion}>
    <slot name="acciones" />
  </PageHeader>

  <div class="doc">
    <div class="doc__contenedor container container--wide">
      <aside class="doc__lateral" aria-label="Navegacion de la documentacion">
        <nav class="doc__arbol">
          {
            arbol.map((nodo) => (
              <ul class="doc__arbol-lista">
                <DocTreeNode nodo={nodo} activo={activo} seccion={seccion} nivel={0} />
              </ul>
            ))
          }
        </nav>
      </aside>

      <article class="doc__cuerpo prose">
        <slot />
      </article>

      <aside class="doc__sumario" aria-label="En esta pagina">
        {
          resumen.length > 0 && (
            <nav>
              <p class="doc__sumario-titulo">En esta pagina</p>
              <ul>
                {resumen.map((h) => (
                  <li class:list={{ 'es-h3': h.depth === 3 }}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .doc__contenedor {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-6) var(--space-9);
  }

  @media (min-width: 64rem) {
    .doc__contenedor {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 80rem) {
    .doc__contenedor {
      grid-template-columns: 15rem minmax(0, 46rem) 13rem;
    }
  }

  .doc__lateral {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
    max-height: calc(100dvh - var(--header-height) - var(--space-8));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  @media (max-width: 63.999rem) {
    .doc__lateral {
      position: static;
      max-height: none;
      padding: var(--space-4);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--surface);
    }
  }

  .doc__arbol {
    display: grid;
    gap: var(--space-1);
  }

  .doc__arbol-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .doc__cuerpo {
    min-width: 0;
  }

  .doc__sumario {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
    font-size: var(--text-sm);
  }

  @media (max-width: 79.999rem) {
    .doc__sumario {
      display: none;
    }
  }

  .doc__sumario-titulo {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-block-end: var(--space-3);
  }

  .doc__sumario ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    border-inline-start: var(--border-width) solid var(--border-subtle);
    padding-inline-start: var(--space-3);
  }

  .doc__sumario li.es-h3 {
    padding-inline-start: var(--space-3);
  }

  .doc__sumario a {
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .doc__sumario a:hover {
    color: var(--accent);
  }
</style>

