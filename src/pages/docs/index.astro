---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { obtenerDocs } from '../../lib/docs';
import { obtenerProyectos } from '../../lib/proyectos';
import { ruta } from '../../lib/site';

const docs = await obtenerDocs();
const proyectos = await obtenerProyectos();

// Secciones en el orden en que se quinieren mostrar.
const ORDEN_SECCIONES = [
  'Guía',
  'Arquitectura',
  'Proyectos',
  'Organización',
];

const secciones = new Map<string, typeof docs>();
for (const doc of docs) {
  const lista = secciones.get(doc.data.seccion) ?? [];
  lista.push(doc);
  secciones.set(doc.data.seccion, lista);
}

const seccionesOrdenadas = [...secciones.entries()].sort(([a], [b]) => {
  const ia = ORDEN_SECCIONES.indexOf(a);
  const ib = ORDEN_SECCIONES.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b, 'es');
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});

const nombreProyecto = new Map(proyectos.map((p) => [p.data.clave, p.data.nombre]));
---

<BaseLayout
  titulo="Documentación"
  descripcion="La documentacion de la organizacion FunshiEngine: guias, arquitectura de los proyectos, manuales de uso y convenciones de trabajo."
>
  <PageHeader
    eyebrow="Documentación"
    titulo="Documentación"
    lede="Manuales de uso, arquitectura, convenciones y notas tecnicas de cada proyecto. Vive junto al codigo y se actualiza con el."
  />

  <div class="secciones container">
    {
      seccionesOrdenadas.map(([seccion, paginas]) => (
        <section class="seccion">
          <div class="seccion__cabecera">
            <h2 class="seccion__titulo">{seccion}</h2>
            <span class="seccion__conteo">
              {paginas.length} {paginas.length === 1 ? 'página' : 'páginas'}
            </span>
          </div>

          <ul class="lista">
            {paginas.map((doc) => (
              <li>
                <a class="pagina" href={ruta(`/docs/${doc.id}/`)}>
                  <span class="pagina__titulo">
                    {doc.data.titulo}
                    {doc.data.proyecto && (
                      <span class="pagina__proyecto">{nombreProyecto.get(doc.data.proyecto)}</span>
                    )}
                  </span>
                  <span class="pagina__descripcion">{doc.data.descripcion}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .secciones {
    display: grid;
    gap: var(--space-9);
    padding-block: var(--space-4) var(--space-10);
  }

  .seccion__cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-width) solid var(--border-subtle);
  }

  .seccion__titulo {
    font-size: var(--text-xl);
  }

  .seccion__conteo {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-subtle);
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .pagina {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: var(--border-width) solid transparent;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .pagina:hover {
    background: var(--surface);
    border-color: var(--border);
  }

  .pagina__titulo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: 550;
    font-size: var(--text-md);
  }

  .pagina:hover .pagina__titulo {
    color: var(--accent);
  }

  .pagina__proyecto {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    color: var(--text-subtle);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
    border: var(--border-width) solid var(--border-subtle);
  }

  .pagina__descripcion {
    color: var(--text-muted);
    font-size: var(--text-base);
  }
</style>
