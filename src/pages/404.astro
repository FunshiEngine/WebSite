---
import BaseLayout from '../layouts/BaseLayout.astro';
import Boton from '../components/Boton.astro';
import { ruta } from '../lib/site';
---

<BaseLayout
  titulo="Página no encontrada"
  descripcion="La página solicitada no existe en el sitio de FunshiEngine."
>
  <section class="error">
    <div class="container container--prose">
      <p class="eyebrow">Error 404</p>
      <h1 class="error__titulo">Esta página no existe</h1>
      <p class="error__texto">
        Puede que el enlace haya cambiado o que la página se haya movido. Desde aqui
        se vuelve a un sitio conocido.
      </p>
      <div class="error__acciones">
        <Boton href={ruta('/')}>Ir al inicio</Boton>
        <Boton variante="secundario" href={ruta('/docs/')}>Ver la documentacion</Boton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error {
    padding-block: var(--space-11) var(--space-10);
    text-align: center;
  }

  .error__titulo {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 400;
    margin-block-start: var(--space-3);
  }

  .error__texto {
    margin-block-start: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .error__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-block-start: var(--space-7);
  }
</style>
