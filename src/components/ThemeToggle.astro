---
/**
 * Interruptor de tema claro/oscuro.
 *
 * El script se ejecuta en el navegador y actualiza el atributo `data-theme`
 * de `<html>`. El estado inicial ya lo aplico el script anti-parpadeo del
 * layout, asi que este boton solo necesita alternar y persistir.
 */
---

<button
  type="button"
  class="tema"
  data-tema-boton
  aria-label="Cambiar entre tema oscuro y claro"
  title="Cambiar tema"
>
  <svg class="tema__sol" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7"></circle>
    <path
      d="M12 2.6v2.2M12 19.2v2.2M21.4 12h-2.2M4.8 12H2.6M18.6 5.4l-1.6 1.6M7 17l-1.6 1.6M18.6 18.6 17 17M7 7 5.4 5.4"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"></path>
  </svg>
  <svg class="tema__luna" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20.2 14.6A8.6 8.6 0 0 1 9.4 3.8a8.6 8.6 0 1 0 10.8 10.8Z"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .tema {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--border);
    color: var(--text-muted);
    background: var(--surface-inset);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .tema:hover {
    color: var(--text);
    background: var(--surface-hover);
    border-color: var(--border-strong);
  }

  .tema svg {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .tema__sol {
    opacity: 0;
    transform: scale(0.7) rotate(-40deg);
  }

  .tema__luna {
    opacity: 1;
    transform: none;
  }

  :global(:root[data-theme='light']) .tema__sol {
    opacity: 1;
    transform: none;
  }

  :global(:root[data-theme='light']) .tema__luna {
    opacity: 0;
    transform: scale(0.7) rotate(40deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tema:hover svg {
      transform: rotate(12deg);
    }

    :global(:root[data-theme='light']) .tema:hover .tema__luna {
      transform: rotate(12deg);
    }
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-tema-boton]');

  boton?.addEventListener('click', () => {
    const raiz = document.documentElement;
    const actual = raiz.dataset.theme;
    const siguiente = actual === 'light' ? 'dark' : 'light';

    raiz.dataset.theme = siguiente;
    raiz.style.colorScheme = siguiente;

    try {
      localStorage.setItem('funshi-tema', siguiente);
    } catch {
      // Almacenamiento no disponible (modo privado): el tema dura la sesion.
    }
  });
</script>
